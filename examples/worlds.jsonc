{
  "$schema": "../schemas/worlds.schema.json",
  "schema_version": 1,

  "defaults": {
    "encoding": "utf-8",
    "reconnect": true,
    "scrollback_lines": 20000,
  },

  "worlds": {
    "example-me": {
      "aliases": ["me"],
      "host": "mux.example.org",
      "port": 4201,
      // Supported adapters: bare, generic, rhost, tinymush, and tinymux.
      "server": "tinymux",
      // These optional per-world values override the defaults above.
      // "encoding": "utf-8",
      // "reconnect": true,
      // "scrollback_lines": 20000,
      // Enables Braille image glyphs for worlds known to preserve Unicode.
      "capabilities": {
        "unicode": true,
      },
      "tls": {
        "enabled": true,
        "verify": true,
        // Use a private CA or override the TLS hostname when required. Relative
        // CA paths resolve from this worlds.jsonc file.
        // "ca_file": "certs/world-ca.pem",
        // "server_hostname": "mux.example.org",
      },
      "login": {
        "character": "Alice",
        "password": "replace-me",
      },
      "autoconnect": true,
      "provenance": {
        // TFR enables and parses NOSPOOF after login on supported servers.
        "nospoof": true,
        // Overrides ui.show_nospoof_prefix for this world. Detection and spoof
        // warnings still work when the wire prefix is hidden.
        "show_prefix": false,
      },
      "idle": {
        "after_seconds": 300,
        "command": "IDLE",
      },
      "startup_commands": [],
    },

    // An agent always uses a separate connection identity.
    "example-agent-world": {
      "host": "mux.example.org",
      "port": 4201,
      "server": "tinymux",
      "tls": {
        "enabled": true,
        "verify": true,
      },
      "login": {
        "character": "ExampleBot",
        "password": "replace-me",
      },
      "autoconnect": true,
      "provenance": {
        "nospoof": true,
      },
    },
  },
}
