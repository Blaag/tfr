#!/usr/bin/env python3
from __future__ import annotations

import os
import pty
import re
import select
import signal
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_TIMEOUT_SECONDS = 3_600


def fail(message: str) -> None:
    raise SystemExit(f"release-end-to-end-agent: {message}")


def configured_timeout() -> int:
    value = os.environ.get("TFR_RELEASE_DRIVER_TIMEOUT_SECONDS", str(DEFAULT_TIMEOUT_SECONDS))
    if not value.isascii() or not value.isdigit() or int(value) <= 0:
        fail("TFR_RELEASE_DRIVER_TIMEOUT_SECONDS must be a positive integer")
    return int(value)


def write_output(data: bytes) -> None:
    stream = getattr(sys.stdout, "buffer", sys.stdout)
    stream.write(data)
    stream.flush()


def terminate(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=5)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()


def main() -> int:
    version_pattern = r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    resume = len(sys.argv) == 3 and sys.argv[1] == "--resume"
    if resume:
        version = sys.argv[2]
    elif len(sys.argv) == 2:
        version = sys.argv[1]
    else:
        fail("usage: ./scripts/release-end-to-end-agent [--resume] VERSION")
    if re.fullmatch(version_pattern, version) is None:
        fail("usage: ./scripts/release-end-to-end-agent [--resume] VERSION")
    script = Path(__file__).resolve().with_name("release-end-to-end")
    if not script.is_file() or not os.access(script, os.X_OK):
        fail(f"release orchestrator is not executable: {script}")

    first_prompt = re.compile(
        rb"Type (v"
        + re.escape(version.encode())
        + rb"(?:-candidate\.[1-9][0-9]*)?) to create and push the protected "
        rb"(?:candidate|release) tag: "
    )
    timeout = configured_timeout()
    terminal, slave = pty.openpty()
    process = subprocess.Popen(
        [str(script), *( ["--resume"] if resume else [] ), version],
        stdin=slave,
        stdout=slave,
        stderr=slave,
        start_new_session=True,
    )
    os.close(slave)
    transcript = bytearray()
    prompt_index = 0
    selected_tag: bytes | None = None
    verified = False
    deadline = time.monotonic() + timeout
    try:
        while time.monotonic() < deadline:
            ready, _, _ = select.select([terminal], [], [], 0.1)
            if ready:
                try:
                    chunk = os.read(terminal, 4096)
                except OSError:
                    chunk = b""
                if chunk:
                    write_output(chunk)
                    transcript.extend(chunk)
                    if len(transcript) > 65_536:
                        del transcript[:-65_536]
                    if prompt_index == 0 and (match := first_prompt.search(transcript)):
                        selected_tag = match.group(1)
                        os.write(terminal, selected_tag + b"\n")
                        prompt_index += 1
                        transcript.clear()
                    elif (
                        prompt_index == 1
                        and selected_tag is not None
                        and b"Type "
                        + selected_tag
                        + b" to approve publication to the release environment: "
                        in transcript
                    ):
                        os.write(terminal, selected_tag + b"\n")
                        prompt_index += 1
                        transcript.clear()
                    if b"Release published and verified:" in transcript:
                        verified = True
            returncode = process.poll()
            if returncode is not None:
                if returncode != 0:
                    return returncode
                if prompt_index != 2 or not verified:
                    fail("orchestrator exited without both prompts and final verification")
                return 0
        fail(f"orchestrator exceeded the {timeout}s driver timeout")
    finally:
        terminate(process)
        os.close(terminal)


if __name__ == "__main__":
    raise SystemExit(main())
