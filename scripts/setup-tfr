#!/bin/sh
set -eu

repository=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

find_uv() {
    if command -v uv >/dev/null 2>&1; then
        command -v uv
        return 0
    fi
    for candidate in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

while ! uv_command=$(find_uv); do
    if [ ! -t 0 ]; then
        printf '%s\n' "setup-tfr: uv is required; install it from https://docs.astral.sh/uv/getting-started/installation/" >&2
        exit 2
    fi
    printf '%s\n' "TFR requires uv, but uv was not found."
    printf '%s\n' "  1) Install uv with Astral's official installer, then re-check"
    printf '%s\n' "  2) Install uv yourself, then press Enter to re-check"
    printf '%s\n' "  3) Exit"
    printf '%s' "Choose [1-3]: "
    IFS= read -r choice
    case "$choice" in
        1)
            command -v curl >/dev/null 2>&1 || {
                printf '%s\n' "setup-tfr: curl is required by the official uv installer" >&2
                continue
            }
            curl -LsSf https://astral.sh/uv/install.sh | sh
            ;;
        2)
            printf '%s\n' "Install uv using: https://docs.astral.sh/uv/getting-started/installation/"
            printf '%s' "Press Enter when uv is installed: "
            IFS= read -r _answer
            ;;
        3)
            printf '%s\n' "Install uv, then rerun: $repository/scripts/setup-tfr"
            exit 0
            ;;
        *) printf '%s\n' "Choose 1, 2, or 3." ;;
    esac
done

command -v git >/dev/null 2>&1 || {
    printf '%s\n' "setup-tfr: git is required to verify and install a stable release" >&2
    exit 2
}

PYTHONPATH="$repository/src"
PYTHONNOUSERSITE=1
PATH=$(dirname "$uv_command"):$PATH
export PYTHONPATH PYTHONNOUSERSITE PATH
exec "$uv_command" run --quiet --isolated --no-project --no-config --python 3.12 \
    python -P -m tfr.setup_install --repository "$repository" "$@"
